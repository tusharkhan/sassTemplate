{
  "name": "wavenode-html-template",
  "version": "1.0.0",
  "description": "WaveNode — AI-Powered Video & Audio Streaming Platform HTML Template (Tailwind CSS + Vanilla JS)",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "pages": "python3 tools/build.py",
    "pages:check": "python3 tools/build.py --check"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
